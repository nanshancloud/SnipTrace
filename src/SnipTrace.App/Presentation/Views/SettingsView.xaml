<UserControl x:Class="SnipTrace.App.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="完全本地处理，不联网、不上传、不收集遥测。" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />

            <TextBlock Text="存储位置" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="截图目录" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="ScreenshotDirBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                <Button Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseScreenshot_Click" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="录屏目录" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="VideoDirBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                <Button Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseVideo_Click" />
            </Grid>

            <TextBlock Text="快捷键" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Grid x:Name="HotkeyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="区域截图" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="CaptureHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10" />

                <TextBlock Grid.Row="1" Text="GIF 录制" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="GifHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10" />

                <TextBlock Grid.Row="2" Text="屏幕录制" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="VideoHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10" />

                <TextBlock Grid.Row="3" Text="当前屏全屏截图" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="FullScreenHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10" />

                <TextBlock Grid.Row="4" Text="所有显示器截图" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="AllScreensHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="格式：Ctrl+Shift+G" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="快捷键被占用时会立即提示" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="托盘菜单始终可用" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="截图与录制" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,10" />
            <CheckBox x:Name="CursorInCaptureCheck" Content="截图包含鼠标指针" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10" />
            <CheckBox x:Name="CopyAfterCaptureCheck" Content="截图完成后自动复制到剪贴板" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10" />
            <CheckBox x:Name="StartupCheck" Content="开机自动启动（写入当前用户启动项）" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                <Button Content="恢复默认" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Reset_Click" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
