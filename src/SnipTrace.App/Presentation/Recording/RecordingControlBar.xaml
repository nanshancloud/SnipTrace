<Window x:Class="SnipTrace.App.Presentation.Recording.RecordingControlBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="#F2161E28"
        AllowsTransparency="False" WindowStartupLocation="Manual">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14,10">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TimeText" Text="00:00" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="MetaText" Text="30 FPS · 0 帧" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PauseButton" Content="暂停" Style="{StaticResource GhostButton}" MinHeight="30"
                            FontSize="12" Click="Pause_Click" />
                    <Button x:Name="StopButton" Content="停止" Style="{StaticResource PrimaryButton}" MinHeight="30"
                            Padding="14,4" FontSize="12" Margin="6,0" Click="Stop_Click" />
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}" MinHeight="30"
                            FontSize="12" Click="Cancel_Click" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="DetailText" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,6,0,0"
                       Text="正在录制，边框位于画面外侧" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</Window>
