<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题画刷：切换主题时整个字典会被替换 -->
    <SolidColorBrush x:Key="BgBrush" Color="#0B0F14" />
    <SolidColorBrush x:Key="PanelBrush" Color="#131A23" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A2330" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#22303F" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#16202B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6B5F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33FF6B5F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF8175" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E85B4F" />
    <SolidColorBrush x:Key="AccentOnBrush" Color="#140F0E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#59E0BE" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F6FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B97A8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#263140" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C5C" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2A3644" />
    <SolidColorBrush x:Key="CheckStrokeBrush" Color="#14100F" />
    <SolidColorBrush x:Key="OverlayMaskBrush" Color="#8C000000" />
    <!-- 浮动工具条 / 悬浮介绍 / 预览面板的半透明底，避免出现死黑块 -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#F2161E28" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#0F151D" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFD166" />
</ResourceDictionary>
