<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题画刷：切换主题时整个字典会被替换 -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F7FA" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E8EDF4" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FDFDFE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6B5F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26FF6B5F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF8175" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E85B4F" />
    <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1FBF8F" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2733" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7A8494" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E7EF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="TrackBrush" Color="#D8DEE8" />
    <SolidColorBrush x:Key="CheckStrokeBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayMaskBrush" Color="#8C000000" />
    <!-- 浮动工具条 / 悬浮介绍 / 预览面板的半透明底，避免出现死黑块 -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#E9EDF3" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#33000000" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B9791A" />
</ResourceDictionary>
