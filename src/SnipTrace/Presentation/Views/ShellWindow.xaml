<Window x:Class="SnipTrace.App.Presentation.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏迹 SnipTrace" Width="1100" Height="720" MinWidth="860" MinHeight="560"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None" Background="{DynamicResource BgBrush}" ResizeMode="CanResize"
        WindowStartupLocation="Manual" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource BgBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Width="18" Height="18" Source="pack://application:,,,/Assets/app.ico"
                       RenderOptions.BitmapScalingMode="HighQuality" ToolTip="屏迹 SnipTrace" />
                <TextBlock Text="屏迹 SnipTrace" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="8,2" Margin="14,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TrayStateText" Text="托盘常驻" Style="{StaticResource CaptionText}" FontSize="11" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center">
                <Button Content="—" Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="最小化" FontSize="13" />
                <Button Content="▢" Style="{StaticResource IconButton}" Click="Maximize_Click" ToolTip="最大化" FontSize="12" />
                <Button Content="✕" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭到托盘" FontSize="12" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavBorder" Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="NavList" Margin="10,12,10,12" />
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TopNavBar" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                    <StackPanel x:Name="TopNavList" Orientation="Horizontal" />
                </Border>

                <!-- Stretch + MaxWidth：页面铺满内容区，超宽屏时由 MaxWidth 居中，避免按期望宽度测量被裁切。 -->
                <ContentControl x:Name="PageHost" Grid.Row="1" MaxWidth="1360" HorizontalAlignment="Stretch"
                                Margin="24,22,24,16" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="ShortcutHintText" Text="F1 截图 · Ctrl+Shift+G GIF · Ctrl+Shift+R 录屏"
                               Style="{StaticResource CaptionText}" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="·" Style="{StaticResource CaptionText}" FontSize="11" Margin="8,0" />
                    <TextBlock x:Name="TrayHintText" Text="托盘常驻" Style="{StaticResource CaptionText}"
                               FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="OutputDirectoryText" Style="{StaticResource CaptionText}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="420"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
