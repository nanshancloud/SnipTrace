<Window x:Class="SnipTrace.App.Presentation.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editing="clr-namespace:SnipTrace.App.Presentation.Editing"
        Title="标注编辑器" Width="1080" Height="720" MinWidth="780" MinHeight="520"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None" Background="{DynamicResource BgBrush}" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource PanelBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="FileNameText" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Content="撤销" Style="{StaticResource GhostButton}" Click="Undo_Click" ToolTip="Ctrl+Z" />
                <Button x:Name="RedoButton" Content="重做" Style="{StaticResource GhostButton}" Click="Redo_Click" ToolTip="Ctrl+Shift+Z" />
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,10" />
                <Button x:Name="CopyButton" Content="复制" Style="{StaticResource GhostButton}" Click="Copy_Click" ToolTip="Ctrl+C" />
                <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}" Padding="14,6" MinHeight="30" Margin="6,0"
                        Click="Save_Click" ToolTip="Ctrl+S" />
                <Button x:Name="PinButton" Content="钉图" Style="{StaticResource GhostButton}" Click="Pin_Click" ToolTip="钉图置顶" />
                <Button x:Name="FullscreenButton" Content="全屏" Style="{StaticResource GhostButton}" Click="Fullscreen_Click" ToolTip="F11" />
                <Button Content="✕" Style="{StaticResource IconButton}" Click="Close_Click" FontSize="12" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PropertiesColumn" Width="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel x:Name="ToolPanel" Margin="4,8">
                    <ToggleButton x:Name="SelectToolButton" Style="{StaticResource ToolButton}" Content="选择" Tag="Select"
                                  IsChecked="True" Click="Tool_Click" ToolTip="选择 / 移动 / 缩放 (V)" />
                    <ToggleButton Style="{StaticResource ToolButton}" Content="矩形" Tag="Rectangle" Click="Tool_Click" ToolTip="矩形 (R)" />
                    <ToggleButton Style="{StaticResource ToolButton}" Content="椭圆" Tag="Ellipse" Click="Tool_Click" ToolTip="椭圆 (E)" />
                    <ToggleButton Style="{StaticResource ToolButton}" Content="箭头" Tag="Arrow" Click="Tool_Click" ToolTip="箭头 (A)" />
                    <ToggleButton Style="{StaticResource ToolButton}" Content="画笔" Tag="Pen" Click="Tool_Click" ToolTip="画笔 (P)" />
                    <ToggleButton Style="{StaticResource ToolButton}" Content="高亮" Tag="Highlight" Click="Tool_Click" ToolTip="高亮笔 (H)" />
                    <ToggleButton Style="{StaticResource ToolButton}" Content="文本" Tag="Text" Click="Tool_Click" ToolTip="文本 (T)" />
                    <ToggleButton Style="{StaticResource ToolButton}" Content="序号" Tag="Number" Click="Tool_Click" ToolTip="序号标签 (N)" />
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="8,10" />
                    <ToggleButton x:Name="FitButton" Style="{StaticResource ToolButton}" Content="适应" Click="Fit_Click" ToolTip="适应窗口" />
                    <ToggleButton x:Name="PropertiesToggle" Style="{StaticResource ToolButton}" Content="属性" Visibility="Collapsed"
                                  Click="PropertiesToggle_Click" ToolTip="属性面板" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
                <editing:AnnotationCanvas x:Name="Canvas" />
                <TextBox x:Name="TextEditorBox" Style="{StaticResource AppTextBox}" Visibility="Collapsed"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left"
                         MinWidth="160" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource AccentBrush}"
                         KeyDown="TextEditor_KeyDown" LostFocus="TextEditor_LostFocus" />
            </Grid>

            <Border x:Name="PropertiesPanel" Grid.Column="2" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,14">
                        <TextBlock Text="颜色" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="ColorPanel" Margin="0,0,0,6" />

                        <TextBlock Text="线宽" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <WrapPanel x:Name="WidthPanel" />

                        <TextBlock Text="字号" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <WrapPanel x:Name="FontSizePanel" />

                        <TextBlock Text="透明度" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <WrapPanel x:Name="OpacityPanel" />

                        <TextBlock Text="序号样式" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <WrapPanel x:Name="BadgePanel" />

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18" />
                        <Button Content="重排编号（阅读顺序）" Style="{StaticResource SecondaryButton}" MinHeight="34"
                                FontSize="12" Click="Renumber_Click" />
                        <Button Content="重置编号（下一个为 1）" Style="{StaticResource GhostButton}" Margin="0,6,0,0"
                                FontSize="12" Click="ResetNumbering_Click" />
                        <TextBlock x:Name="NumberHintText" Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="StatusLeft" Style="{StaticResource CaptionText}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusRight" Style="{StaticResource CaptionText}" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Text="Ctrl+Z 撤销 · Delete 删除 · 滚轮缩放 · Esc 关闭" />
            </Grid>
        </Border>
    </Grid>
</Window>
