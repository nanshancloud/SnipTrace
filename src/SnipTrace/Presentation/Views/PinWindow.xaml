<Window x:Class="SnipTrace.App.Presentation.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editing="clr-namespace:SnipTrace.App.Presentation.Editing"
        WindowStyle="None" Background="{DynamicResource PanelBrush}" Topmost="True" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" AllowsTransparency="False"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- 深浅色主题通用的钉图菜单（挂在工具条「更多」上） -->
        <Style x:Key="PinMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="10,6">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,4" Background="{DynamicResource BorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Background="{DynamicResource PanelBrush}">
        <Grid>
            <!-- 可交互画布：悬浮即选中标注，拖动移动、四角调整；空白处按下仍拖整个钉图 -->
            <editing:AnnotationCanvas x:Name="Canvas" Focusable="False" />
            <TextBox x:Name="TextEditorBox" Style="{StaticResource AppTextBox}" Visibility="Collapsed"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left"
                     MinWidth="160" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource AccentBrush}"
                     KeyDown="TextEditor_KeyDown" LostFocus="TextEditor_LostFocus" />

            <!-- Snipaste 式工具条：悬停或右键唤出，图标不占画面 -->
            <Border x:Name="ToolBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0"
                    Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="3" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CopyButton" Style="{StaticResource ToolIconButton}" Click="Copy_Click"
                            ToolTip="{DynamicResource 复制到剪贴板 (Ctrl+C)}">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource ToolIconButton}" Click="Save_Click"
                            ToolTip="{DynamicResource 另存为… (Ctrl+S)，默认定位到截图目录}">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="SaveToDirButton" Style="{StaticResource ToolIconButton}" Click="SaveToDirectory_Click"
                            ToolTip="{DynamicResource 存到截图目录（不弹对话框）}">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Button x:Name="RefineButton" Style="{StaticResource ToolIconButton}" Click="Refine_Click"
                            ToolTip="{DynamicResource 精修：在标注编辑器中继续编辑}">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                    <Border Width="1" Height="16" Margin="4,0" Background="{DynamicResource BorderBrush}" />
                    <Button x:Name="ZoomButton" Style="{StaticResource ToolIconButton}" Click="ZoomReset_Click"
                            ToolTip="{DynamicResource 当前缩放，点击恢复原始大小（滚轮缩放）}">
                        <TextBlock x:Name="ZoomText" Text="100%" FontSize="11" FontFamily="Segoe UI" />
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource ToolIconButton}" Click="More_Click"
                            ToolTip="{DynamicResource 更多操作（透明度 / 关闭）}">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource PinMenu}">
                                <MenuItem Header="{DynamicResource 复制 (Ctrl+C)}" Style="{StaticResource PinMenuItem}" Click="Copy_Click" />
                                <MenuItem Header="{DynamicResource 另存为… (Ctrl+S)}" Style="{StaticResource PinMenuItem}" Click="Save_Click" />
                                <MenuItem Header="{DynamicResource 存到截图目录}" Style="{StaticResource PinMenuItem}" Click="SaveToDirectory_Click" />
                                <Separator Style="{StaticResource PinMenuSeparator}" />
                                <MenuItem x:Name="OpacityMenu" Header="{DynamicResource 半透明显示 (Alt+滚轮)}" Style="{StaticResource PinMenuItem}"
                                          Click="ToggleOpacity_Click" />
                                <MenuItem Header="{DynamicResource 恢复原始大小}" Style="{StaticResource PinMenuItem}" Click="ZoomReset_Click" />
                                <Separator Style="{StaticResource PinMenuSeparator}" />
                                <MenuItem Header="{DynamicResource 关闭钉图 (Esc)}" Style="{StaticResource PinMenuItem}" Click="Close_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Border Width="1" Height="16" Margin="4,0" Background="{DynamicResource BorderBrush}" />
                    <Button x:Name="CloseButton" Style="{StaticResource ToolIconButton}" Click="Close_Click"
                            ToolTip="{DynamicResource 关闭钉图 (Esc)}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
