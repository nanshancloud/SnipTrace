<UserControl x:Class="SnipTrace.App.Presentation.Views.ModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="GIF 录制" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Text="选区录制循环动图，边编码边写盘，失败不留半成品。"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />

            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="20" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="帧率" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <StackPanel x:Name="FpsPanel" Orientation="Horizontal" />

                    <StackPanel x:Name="GifOnlyPanel">
                        <TextBlock Text="最大时长（秒）" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,10" />
                        <TextBox x:Name="MaxDurationBox" Style="{StaticResource AppTextBox}" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Text="最大帧数" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,10" />
                        <TextBox x:Name="MaxFramesBox" Style="{StaticResource AppTextBox}" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Text="最大边长" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,10" />
                        <StackPanel x:Name="EdgePanel" Orientation="Horizontal" />
                        <CheckBox x:Name="DitherCheck" Content="高质量抖动（渐变更平滑，体积略增）" Style="{StaticResource AppCheckBox}"
                                  Margin="0,18,0,0" />
                    </StackPanel>

                    <CheckBox x:Name="CursorCheck" Content="录制画面包含鼠标指针" Style="{StaticResource AppCheckBox}" Margin="0,18,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Content="选择区域并开始" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
                        <TextBlock x:Name="HintText" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="录制规则" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock x:Name="RulesText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
