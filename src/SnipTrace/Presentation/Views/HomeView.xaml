<UserControl x:Class="SnipTrace.App.Presentation.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <DockPanel x:Name="ContentDock" LastChildFill="True">

            <StackPanel x:Name="RecentPanel" DockPanel.Dock="Bottom" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="最近捕获" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="RecentHint" Text="点击缩略图打开文件" Style="{StaticResource CaptionText}" Margin="12,4,0,0" />
                </StackPanel>
                <ItemsControl x:Name="RecentList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Width="168" Padding="8"
                                    Margin="0,0,10,10" Cursor="Hand" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    MouseLeftButtonUp="RecentItem_MouseLeftButtonUp">
                                <StackPanel>
                                    <Border Height="88" CornerRadius="6" Background="#0F151D" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Margin="2,8,2,0" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="2,2,2,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyRecent" Text="还没有捕获记录，按 F1 开始第一次截图。" Style="{StaticResource CaptionText}" />
            </StackPanel>

            <StackPanel x:Name="MainPanel">
                <StackPanel x:Name="HeaderPanel" Margin="0,0,0,20">
                    <TextBlock x:Name="TitleText" Text="捕捉，标注，讲清楚" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="SubtitleText" Text="区域截图、GIF 动图与高清录屏，一次完成"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <UniformGrid x:Name="CardGrid" Columns="3">
                    <Button x:Name="ScreenshotCard" Style="{StaticResource CardButton}" Margin="0,0,12,0" Click="ScreenshotCard_Click">
                        <StackPanel>
                            <TextBlock Text="区域截图" FontSize="16" FontWeight="SemiBold" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Left" Margin="0,10,0,10">
                                <TextBlock Text="F1" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            </Border>
                            <TextBlock Text="冻结桌面后框选，支持跨显示器连续选区、比例锁定与像素级放大镜。"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="开始截图 →" Foreground="{StaticResource AccentBrush}" Margin="0,16,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="GifCard" Style="{StaticResource CardButton}" Margin="0,0,12,0" Click="GifCard_Click">
                        <StackPanel>
                            <TextBlock Text="GIF 录制" FontSize="16" FontWeight="SemiBold" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Left" Margin="0,10,0,10">
                                <TextBlock Text="Ctrl+Shift+G" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            </Border>
                            <TextBlock Text="选区录制循环动图，帧率与最大边长可调，边编码边写盘。"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="录制 GIF →" Foreground="{StaticResource AccentBrush}" Margin="0,16,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="VideoCard" Style="{StaticResource CardButton}" Click="VideoCard_Click">
                        <StackPanel>
                            <TextBlock Text="屏幕录制" FontSize="16" FontWeight="SemiBold" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Left" Margin="0,10,0,10">
                                <TextBlock Text="Ctrl+Shift+R" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                            </Border>
                            <TextBlock Text="单显示器选区录制 H.264 MP4，暂停不计入成片，失败不留半成品。"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="开始录屏 →" Foreground="{StaticResource AccentBrush}" Margin="0,16,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <StackPanel x:Name="QuickActionsPanel" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="快捷入口" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="FullScreenButton" Style="{StaticResource GhostButton}" Content="当前显示器全屏"
                            Click="FullScreenButton_Click" />
                    <Button x:Name="AllScreensButton" Style="{StaticResource GhostButton}" Content="所有显示器全屏"
                            Click="AllScreensButton_Click" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </ScrollViewer>
</UserControl>
