<UserControl x:Class="SnipTrace.App.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SnipTrace.App.Presentation.Controls"
             xmlns:platform="clr-namespace:SnipTrace.App.Infrastructure.Platform">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource 设置}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource 完全本地处理，不联网、不上传、不收集遥测。}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />

            <TextBlock Text="{DynamicResource 存储位置}" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource 截图目录}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="ScreenshotDirBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                <Button Grid.Column="2" Content="{DynamicResource 浏览}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseScreenshot_Click" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource 录屏目录}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="VideoDirBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                <Button Grid.Column="2" Content="{DynamicResource 浏览}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseVideo_Click" />
            </Grid>

            <TextBlock Text="{DynamicResource 快捷键}" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="HotkeyIndividualRadio" Content="{DynamicResource 三种动作独立快捷键}" GroupName="HotkeyMode"
                             Style="{StaticResource FormatRadio}"
                             ToolTip="{DynamicResource 截图、GIF、录屏各有单独快捷键，按下直接开始对应动作}" />
                <RadioButton x:Name="HotkeyUnifiedRadio" Content="{DynamicResource 统一快捷键}" GroupName="HotkeyMode" Margin="8,0,0,0"
                             Style="{StaticResource FormatRadio}"
                             ToolTip="{DynamicResource 只用「区域截图」快捷键唤起选区，选完后在工具条上选择 GIF / 录屏 / 完成}" />
                <Button Content="{DynamicResource 重置快捷键}" Style="{StaticResource SecondaryButton}" Margin="18,0,0,0"
                        Click="ResetHotkeys_Click" ToolTip="{DynamicResource 把五个快捷键全部恢复成默认值}" />
            </StackPanel>
            <Grid x:Name="HotkeyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource 区域截图}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <controls:HotkeyInput Grid.Row="0" Grid.Column="1" x:Name="CaptureHotkeyInput" Margin="0,0,20,10" />

                <TextBlock Grid.Row="1" x:Name="GifHotkeyInputLabel" Text="{DynamicResource GIF 录制}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <controls:HotkeyInput Grid.Row="1" Grid.Column="1" x:Name="GifHotkeyInput" Margin="0,0,20,10" />

                <TextBlock Grid.Row="2" x:Name="VideoHotkeyInputLabel" Text="{DynamicResource 屏幕录制}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <controls:HotkeyInput Grid.Row="2" Grid.Column="1" x:Name="VideoHotkeyInput" Margin="0,0,20,10" />

                <TextBlock Grid.Row="3" Text="{DynamicResource 当前屏全屏截图}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <controls:HotkeyInput Grid.Row="3" Grid.Column="1" x:Name="FullScreenHotkeyInput" Margin="0,0,20,10" />

                <TextBlock Grid.Row="4" Text="{DynamicResource 所有显示器截图}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <controls:HotkeyInput Grid.Row="4" Grid.Column="1" x:Name="AllScreensHotkeyInput" Margin="0,0,20,10" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource 点一下直接按组合键}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Backspace 清除}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource Esc 退出录入}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{DynamicResource 外观}" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource 语言}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                          ItemsSource="{x:Static platform:LanguageManager.Supported}"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Code" />
            </Grid>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeDarkRadio" Content="{DynamicResource 深色}" GroupName="AppTheme" Style="{StaticResource FormatRadio}"
                             ToolTip="{DynamicResource 深色界面（默认）}" />
                <RadioButton x:Name="ThemeLightRadio" Content="{DynamicResource 浅色}" GroupName="AppTheme" Margin="8,0,0,0"
                             Style="{StaticResource FormatRadio}" ToolTip="{DynamicResource 浅色界面，选中即生效}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource 托盘图标}" Width="72" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <RadioButton x:Name="TrayAutoRadio" Content="{DynamicResource 自动}" GroupName="TrayIconMode" Style="{StaticResource FormatRadio}"
                             ToolTip="{DynamicResource 跟随任务栏明暗自动切换浅色 / 深色图标}" />
                <RadioButton x:Name="TrayColorRadio" Content="{DynamicResource 彩色}" GroupName="TrayIconMode" Margin="8,0,0,0"
                             Style="{StaticResource FormatRadio}" ToolTip="{DynamicResource 始终使用品牌强调色图标}" />
                <RadioButton x:Name="TrayLightRadio" Content="{DynamicResource 浅色}" GroupName="TrayIconMode" Margin="8,0,0,0"
                             Style="{StaticResource FormatRadio}" ToolTip="{DynamicResource 始终使用浅色图标，适合深色任务栏}" />
            </StackPanel>

            <CheckBox x:Name="TrayHintCheck" Content="{DynamicResource 最小化到托盘时显示提示}" Style="{StaticResource AppCheckBox}" Margin="0,10,0,0"
                      ToolTip="{DynamicResource 关闭后不再弹出「已最小化到托盘」提示（也可在提示上点「不再提示」）}" />

            <TextBlock Text="{DynamicResource 选区工具条}" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,6" />
            <TextBlock Text="{DynamicResource 下面是工具条的真实外观：点按钮切换显示（变暗即隐藏），按住拖动调整顺序，改动立即生效。}"
                       Style="{StaticResource CaptionText}" Margin="0,0,0,10" TextWrapping="Wrap" />
            <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="5,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                <WrapPanel x:Name="ToolbarPreviewPanel" AllowDrop="True" />
            </Border>
            <Button Content="{DynamicResource 恢复默认工具条}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Click="ResetToolbar_Click" ToolTip="{DynamicResource 恢复全部按钮并按默认顺序排列}" />

            <TextBlock Text="{DynamicResource 截图与录制}" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <CheckBox x:Name="CursorInCaptureCheck" Content="{DynamicResource 截图包含鼠标指针}" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10" />
            <CheckBox x:Name="CopyAfterCaptureCheck" Content="{DynamicResource 截图完成后自动复制到剪贴板}" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10" />
            <CheckBox x:Name="AutoSaveCheck" Content="{DynamicResource 截图后自动保存到截图目录（复制、钉图、进编辑器时静默保存 PNG）}"
                      Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="{DynamicResource 开启后保存按钮也直接存入截图目录；关闭时保存按钮弹出另存为对话框}" />
            <CheckBox x:Name="HotkeyWarnCheck" Content="{DynamicResource 快捷键注册失败时弹窗提醒}" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="{DynamicResource 关闭后快捷键被占用只记录，不再弹提示}" />
            <CheckBox x:Name="StartupCheck" Content="{DynamicResource 开机自动启动（写入当前用户启动项，静默驻留托盘）}" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="{DynamicResource 开机后在托盘待命并注册快捷键，不弹出主窗口}" />
            <CheckBox x:Name="CheckUpdateCheck" Content="{DynamicResource 启动时检查更新（GitHub Releases）}" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="{DynamicResource 关闭后启动不再联网检查版本；关于页仍可手动点「检查更新」}" />

            <TextBlock Text="{DynamicResource 标注}" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource 文本字体}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="TextFontBox" Grid.Column="1" Width="220" IsReadOnly="True"
                         Style="{StaticResource AppTextBox}"
                         ToolTip="{DynamicResource 覆盖层文本工具与编辑器新建文本标注使用的字体}" />
                <Button Grid.Column="2" Content="{DynamicResource 选择字体…}" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Margin="10,0,0,0" Click="PickTextFont_Click"
                        ToolTip="{DynamicResource 打开系统字体对话框挑选字体}" />
            </Grid>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0" HorizontalAlignment="Left">
                <TextBlock x:Name="TextFontSample" Text="{DynamicResource 文本标注示例 Aa 123}" FontSize="18" />
            </Border>

            <TextBlock Text="{DynamicResource 鼠标高亮（演示模式）}" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <CheckBox x:Name="HighlightCheck" Content="{DynamicResource 录制 GIF / MP4 时高亮显示鼠标位置}" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="{DynamicResource 开启后在光标位置绘制半透明色圈，GIF 与 MP4 均生效}" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource 高亮颜色}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush x:Name="HighlightSwatch" Color="#FFCC00" />
                    </Border.Background>
                </Border>
                <TextBox x:Name="HighlightColorBox" Grid.Column="2" Style="{StaticResource AppTextBox}"
                         ToolTip="{DynamicResource #RRGGBB 或 #AARRGGBB，例如 FFCC00 / 3478FF}" />
                <Button Grid.Column="3" Content="{DynamicResource 取色…}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Click="PickHighlightColor_Click" ToolTip="{DynamicResource 打开系统取色对话框，选完自动填入色值}" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource 高亮直径 (px)}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="HighlightSizeBox" Grid.Column="1" Style="{StaticResource AppTextBox}" Margin="0,0,20,0"
                         ToolTip="{DynamicResource 16–200 物理像素}" />
                <TextBlock Grid.Column="2" Text="{DynamicResource 不透明度 (%)}" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="HighlightOpacityBox" Grid.Column="3" Style="{StaticResource AppTextBox}"
                         ToolTip="{DynamicResource 10–80，色圈填充不透明度}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="{DynamicResource 恢复默认}" Style="{StaticResource SecondaryButton}" Click="Reset_Click"
                        ToolTip="{DynamicResource 恢复全部设置为默认值，同样立即生效}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="{DynamicResource 修改即生效，无需保存}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
