<UserControl x:Class="SnipTrace.App.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="完全本地处理，不联网、不上传、不收集遥测。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />

            <TextBlock Text="存储位置" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="截图目录" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="ScreenshotDirBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                <Button Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseScreenshot_Click" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="录屏目录" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="VideoDirBox" Grid.Column="1" Style="{StaticResource AppTextBox}" />
                <Button Grid.Column="2" Content="浏览" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="BrowseVideo_Click" />
            </Grid>

            <TextBlock Text="快捷键" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="HotkeyIndividualRadio" Content="三种动作独立快捷键" GroupName="HotkeyMode"
                             Style="{StaticResource FormatRadio}"
                             ToolTip="截图、GIF、录屏各有单独快捷键，按下直接开始对应动作" />
                <RadioButton x:Name="HotkeyUnifiedRadio" Content="统一快捷键" GroupName="HotkeyMode" Margin="8,0,0,0"
                             Style="{StaticResource FormatRadio}"
                             ToolTip="只用「区域截图」快捷键唤起选区，选完后在工具条上选择 GIF / 录屏 / 完成" />
            </StackPanel>
            <Grid x:Name="HotkeyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="区域截图" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="CaptureHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10"
                         ToolTip="点击后直接按下组合键即可录入；Backspace 清除，Esc 取消" />

                <TextBlock Grid.Row="1" Text="GIF 录制" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="GifHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10"
                         ToolTip="点击后直接按下组合键即可录入；Backspace 清除，Esc 取消" />

                <TextBlock Grid.Row="2" Text="屏幕录制" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="VideoHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10"
                         ToolTip="点击后直接按下组合键即可录入；Backspace 清除，Esc 取消" />

                <TextBlock Grid.Row="3" Text="当前屏全屏截图" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="FullScreenHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10"
                         ToolTip="点击后直接按下组合键即可录入；Backspace 清除，Esc 取消" />

                <TextBlock Grid.Row="4" Text="所有显示器截图" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="AllScreensHotkeyBox" Style="{StaticResource AppTextBox}" Margin="0,0,20,10"
                         ToolTip="点击后直接按下组合键即可录入；Backspace 清除，Esc 取消" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="点输入框后按键录入" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Backspace 清除" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Esc 取消本次录入" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeDarkRadio" Content="深色" GroupName="AppTheme" Style="{StaticResource FormatRadio}"
                             ToolTip="深色界面（默认）" />
                <RadioButton x:Name="ThemeLightRadio" Content="浅色" GroupName="AppTheme" Margin="8,0,0,0"
                             Style="{StaticResource FormatRadio}" ToolTip="浅色界面，选中即生效" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="托盘图标" Width="72" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <RadioButton x:Name="TrayAutoRadio" Content="自动" GroupName="TrayIconMode" Style="{StaticResource FormatRadio}"
                             ToolTip="跟随任务栏明暗自动切换浅色 / 深色图标" />
                <RadioButton x:Name="TrayColorRadio" Content="彩色" GroupName="TrayIconMode" Margin="8,0,0,0"
                             Style="{StaticResource FormatRadio}" ToolTip="始终使用品牌强调色图标" />
                <RadioButton x:Name="TrayLightRadio" Content="浅色" GroupName="TrayIconMode" Margin="8,0,0,0"
                             Style="{StaticResource FormatRadio}" ToolTip="始终使用浅色图标，适合深色任务栏" />
            </StackPanel>

            <CheckBox x:Name="TrayHintCheck" Content="最小化到托盘时显示提示" Style="{StaticResource AppCheckBox}" Margin="0,10,0,0"
                      ToolTip="关闭后不再弹出「已最小化到托盘」提示（也可在提示上点「不再提示」）" />

            <TextBlock Text="选区工具条" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,6" />
            <TextBlock Text="下面是工具条的真实外观：点按钮切换显示（变暗即隐藏），按住拖动调整顺序，改动立即生效。"
                       Style="{StaticResource CaptionText}" Margin="0,0,0,10" TextWrapping="Wrap" />
            <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="5,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                <WrapPanel x:Name="ToolbarPreviewPanel" />
            </Border>
            <Button Content="恢复默认工具条" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Click="ResetToolbar_Click" ToolTip="恢复全部按钮并按默认顺序排列" />

            <TextBlock Text="截图与录制" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <CheckBox x:Name="CursorInCaptureCheck" Content="截图包含鼠标指针" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10" />
            <CheckBox x:Name="CopyAfterCaptureCheck" Content="截图完成后自动复制到剪贴板" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10" />
            <CheckBox x:Name="AutoSaveCheck" Content="截图后自动保存到截图目录（复制、钉图、进编辑器时静默保存 PNG）"
                      Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="开启后保存按钮也直接存入截图目录；关闭时保存按钮弹出另存为对话框" />
            <CheckBox x:Name="HotkeyWarnCheck" Content="快捷键注册失败时弹窗提醒" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="关闭后快捷键被占用只记录，不再弹提示" />
            <CheckBox x:Name="StartupCheck" Content="开机自动启动（写入当前用户启动项，静默驻留托盘）" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="开机后在托盘待命并注册快捷键，不弹出主窗口" />
            <CheckBox x:Name="CheckUpdateCheck" Content="启动时检查更新（GitHub Releases）" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="关闭后启动不再联网检查版本；关于页仍可手动点「检查更新」" />

            <TextBlock Text="鼠标高亮（演示模式）" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
            <CheckBox x:Name="HighlightCheck" Content="录制 GIF / MP4 时高亮显示鼠标位置" Style="{StaticResource AppCheckBox}" Margin="0,0,0,10"
                      ToolTip="开启后在光标位置绘制半透明色圈，GIF 与 MP4 均生效" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="高亮颜色" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Background>
                        <SolidColorBrush x:Name="HighlightSwatch" Color="#FFCC00" />
                    </Border.Background>
                </Border>
                <TextBox x:Name="HighlightColorBox" Grid.Column="2" Style="{StaticResource AppTextBox}"
                         ToolTip="#RRGGBB 或 #AARRGGBB，例如 FFCC00 / 3478FF" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="高亮直径 (px)" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="HighlightSizeBox" Grid.Column="1" Style="{StaticResource AppTextBox}" Margin="0,0,20,0"
                         ToolTip="16–200 物理像素" />
                <TextBlock Grid.Column="2" Text="不透明度 (%)" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                <TextBox x:Name="HighlightOpacityBox" Grid.Column="3" Style="{StaticResource AppTextBox}"
                         ToolTip="10–80，色圈填充不透明度" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="恢复默认" Style="{StaticResource SecondaryButton}" Click="Reset_Click"
                        ToolTip="恢复全部设置为默认值，同样立即生效" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="修改即生效，无需保存" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
