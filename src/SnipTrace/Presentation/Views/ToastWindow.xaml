<Window x:Class="SnipTrace.App.Presentation.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize">
    <Border Background="#F21A2330" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Padding="14,12" Margin="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="AccentBar" Width="3" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,1,12,1" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
