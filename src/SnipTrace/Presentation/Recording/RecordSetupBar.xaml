<Window x:Class="SnipTrace.App.Presentation.Recording.RecordSetupBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="Manual" Title="SnipTrace Record Setup">
    <Border Background="#F2161E28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="24" Padding="14,8">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="选择格式" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center" />
            <RadioButton x:Name="Mp4Radio" Content="MP4" GroupName="RecordFormat" IsChecked="True"
                         Style="{StaticResource FormatRadio}" Margin="6,0,0,0" Checked="Format_Changed"
                         ToolTip="录制成 MP4 视频，清晰度可选" />
            <RadioButton x:Name="GifRadio" Content="GIF" GroupName="RecordFormat"
                         Style="{StaticResource FormatRadio}" Margin="4,0,0,0" Checked="Format_Changed"
                         ToolTip="录制成循环 GIF 动图（清晰度档位不适用）" />

            <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}"
                    Margin="12,0" VerticalAlignment="Center" />

            <TextBlock Text="清晰度" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       VerticalAlignment="Center" />
            <Button x:Name="QualityButton" Content="标准" Style="{StaticResource GhostButton}"
                    MinHeight="28" MinWidth="64" FontSize="12" Margin="6,0,0,0" Click="Quality_Click"
                    ToolTip="MP4 码率档位：标准按分辨率自动估算，高清 12 Mbps，超清 24 Mbps" />
            <Popup x:Name="QualityPopup" PlacementTarget="{Binding ElementName=QualityButton}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#F5161E28" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="4" Margin="6">
                    <StackPanel>
                        <Button Content="标准" Style="{StaticResource SelectionMenuItem}" Click="QualityOption_Click" Tag="0" />
                        <Button Content="高清" Style="{StaticResource SelectionMenuItem}" Click="QualityOption_Click" Tag="12" />
                        <Button Content="超清" Style="{StaticResource SelectionMenuItem}" Click="QualityOption_Click" Tag="24" />
                    </StackPanel>
                </Border>
            </Popup>

            <Button Content="开始录制" Style="{StaticResource PrimaryButton}" MinHeight="30"
                    Padding="18,4" FontSize="12" Margin="16,0,0,0" Click="Start_Click"
                    ToolTip="按所选格式与清晰度开始录制（先 3 秒倒计时）" />
            <Button Content="退出录制" Style="{StaticResource GhostButton}" MinHeight="30"
                    Padding="14,4" FontSize="12" Margin="8,0,0,0" Click="Exit_Click"
                    ToolTip="退出本次录制（Esc 同效）" />
        </StackPanel>
    </Border>
</Window>
