<Window x:Class="SnipTrace.App.Presentation.Recording.RecordingControlBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="#F2161E28"
        AllowsTransparency="False" WindowStartupLocation="Manual">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="12,6">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource DangerBrush}"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="TimeText" Text="00:00" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="MetaText" Text="30 FPS · 0 帧" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="150" TextTrimming="CharacterEllipsis" />
            <Button x:Name="PauseButton" Width="30" Height="30" Margin="10,0,0,0" Style="{StaticResource IconButton}"
                    ToolTip="暂停 / 继续" Click="Pause_Click">
                <TextBlock x:Name="PauseGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
            </Button>
            <Button x:Name="StopButton" Width="30" Height="30" Margin="4,0,0,0" ToolTip="停止并保存"
                    Click="Stop_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="{DynamicResource DangerBrush}" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <TextBlock Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
            </Button>
            <Button x:Name="CancelButton" Width="30" Height="30" Margin="4,0,0,0" Style="{StaticResource IconButton}"
                    ToolTip="取消录制" Click="Cancel_Click">
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
            </Button>
        </StackPanel>
    </Border>
</Window>
