<Window x:Class="SnipTrace.App.Presentation.Recording.RecordingResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterScreen" Title="制作录像">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" MouseLeftButtonDown="Root_MouseDown">
        <StackPanel>
            <!-- 标题栏：制作MP4 / 制作GIF -->
            <Border Height="42" Padding="16,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="38" Height="30" Margin="0,0,2,0"
                                ToolTip="最小化" Click="Minimize_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="38" Height="30"
                                ToolTip="关闭" Click="Close_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="TitleText" Text="制作MP4" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- 预览画面 -->
            <Border Height="300" Margin="14,0,14,0" CornerRadius="8" Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <MediaElement x:Name="VideoPreview" Stretch="Uniform" Visibility="Collapsed"
                                  LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
                                  MediaOpened="VideoPreview_MediaOpened" MediaEnded="VideoPreview_MediaEnded"
                                  MediaFailed="VideoPreview_MediaFailed" />
                </Grid>
            </Border>

            <!-- 播放控制：进度条 + 播放/时间/循环/下载 -->
            <StackPanel Margin="14,10,14,0">
                <Slider x:Name="PlayerSlider" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="100"
                        ValueChanged="PlayerSlider_ValueChanged" />
                <DockPanel Margin="0,4,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="32" Height="28"
                                ToolTip="播放 / 暂停" Click="PlayPause_Click">
                            <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" />
                        </Button>
                        <TextBlock x:Name="TimeText" Text="00:00 / 00:00" Style="{StaticResource CaptionText}"
                                   FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="LoopButton" Style="{StaticResource IconButton}" Width="34" Height="28"
                                ToolTip="循环播放：开" Click="Loop_Click">
                            <TextBlock x:Name="LoopGlyph" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="28" Margin="6,0,0,0"
                                ToolTip="另存为" Click="SaveAs_Click">
                            <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="InfoText" Style="{StaticResource CaptionText}" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,8,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>

            <!-- 操作按钮 -->
            <WrapPanel Margin="14,12,14,14">
                <Button x:Name="ConvertButton" Content="转 GIF" Style="{StaticResource SecondaryButton}"
                        Click="ConvertToGif_Click" Margin="0,0,8,6"
                        ToolTip="把当前 MP4 转成 GIF 动图（使用设置的 GIF 帧率与最大边长）" />
                <Button Content="打开文件" Style="{StaticResource PrimaryButton}" Click="Open_Click" Margin="0,0,8,6"
                        ToolTip="用系统默认程序打开录制文件" />
                <Button Content="打开文件夹" Style="{StaticResource SecondaryButton}" Click="Folder_Click" Margin="0,0,8,6"
                        ToolTip="在资源管理器中定位录制文件" />
                <Button Content="另存为" Style="{StaticResource GhostButton}" Click="SaveAs_Click" Margin="0,0,8,6"
                        ToolTip="把录制文件复制到指定位置" />
                <Button Content="复制" Style="{StaticResource GhostButton}" Click="Copy_Click" Margin="0,0,8,6"
                        ToolTip="复制文件到剪贴板，可直接粘贴到聊天窗口" />
                <Button Content="完成" Style="{StaticResource GhostButton}" Click="Close_Click" Margin="0,0,0,6"
                        ToolTip="关闭预览窗口" />
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
