<Window x:Class="SnipTrace.App.Presentation.Selection.SelectionContextMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" WindowStartupLocation="Manual" SizeToContent="WidthAndHeight"
        AllowsTransparency="True" Background="Transparent" Title="SnipTrace Menu">
    <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="8" Padding="4">
        <StackPanel x:Name="MenuPanel" MinWidth="196" />
    </Border>
</Window>
