<Window x:Class="SnipTrace.App.Presentation.Selection.SelectionHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" WindowStartupLocation="Manual" SizeToContent="WidthAndHeight"
        AllowsTransparency="True" Background="Transparent" Title="SnipTrace Hint">
    <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="9,5">
        <TextBlock x:Name="HintText" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
    </Border>
</Window>
