<Window x:Class="SnipTrace.App.Presentation.Selection.SelectionToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        Background="#F2161E28" AllowsTransparency="False" WindowStartupLocation="Manual">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6,4">
        <StackPanel x:Name="ButtonRow" Orientation="Horizontal" />
    </Border>
</Window>
