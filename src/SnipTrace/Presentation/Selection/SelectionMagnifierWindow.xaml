<Window x:Class="SnipTrace.App.Presentation.Selection.SelectionMagnifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" WindowStartupLocation="Manual" SizeToContent="WidthAndHeight"
        Background="{DynamicResource CanvasBrush}" Title="SnipTrace Magnifier">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8">
        <StackPanel Orientation="Horizontal">
            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" ClipToBounds="True">
                <Grid Width="120" Height="120">
                    <Image x:Name="ZoomImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Canvas x:Name="CrosshairLayer" Width="120" Height="120" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <StackPanel Width="96" Margin="9,3,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="SizeText" FontSize="13" FontWeight="SemiBold" Text="—"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="RatioText" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="OriginText" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CoordText" Style="{StaticResource CaptionText}" FontSize="11" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="GapText" Foreground="{DynamicResource WarnBrush}" FontSize="10" Margin="0,3,0,0"
                           Visibility="Collapsed" Text="跨屏选区，导出填黑" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Border x:Name="ColorSwatch" Width="11" Height="11" CornerRadius="2"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock x:Name="ColorText" Style="{StaticResource CaptionText}" FontSize="11" Margin="5,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
